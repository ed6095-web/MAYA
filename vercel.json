{
  "version": 2,
  "buildCommand": "cd website && npm install && npm run build",
  "outputDirectory": "website/dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/downloads/(.*)",
      "dest": "/downloads/$1"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
